<UserControl x:Class="PasswordField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" IsTabStop="False">
    <StackPanel>
        <Grid>
            <PasswordBox x:Name="HiddenBox" Padding="12,9,46,9" MaxLength="128" PasswordChanged="HiddenBox_PasswordChanged"/>
            <TextBox x:Name="VisibleBox" Padding="12,9,46,9" MaxLength="128" Visibility="Collapsed" TextChanged="VisibleBox_TextChanged"/>
            <TextBlock x:Name="PlaceholderText" Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False"
                       Margin="15,0,46,0" VerticalAlignment="Center" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="RevealButton" Style="{StaticResource IconButton}" Width="32" Height="30" Margin="0,0,5,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="False"
                    Content="&#xE7B3;" ToolTip="Show password" Click="Reveal_Click"
                    AutomationProperties.Name="Show or hide password"/>
        </Grid>

        <!-- Strength meter: theme shades only (red/yellow/green/gray are reserved for stock status) -->
        <StackPanel x:Name="StrengthPanel" Margin="0,9,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Segment1" Height="5" CornerRadius="3" Background="{StaticResource LavenderBrush}" VerticalAlignment="Center"/>
                <Border x:Name="Segment2" Grid.Column="2" Height="5" CornerRadius="3" Background="{StaticResource LavenderBrush}" VerticalAlignment="Center"/>
                <Border x:Name="Segment3" Grid.Column="4" Height="5" CornerRadius="3" Background="{StaticResource LavenderBrush}" VerticalAlignment="Center"/>
                <Border x:Name="Segment4" Grid.Column="6" Height="5" CornerRadius="3" Background="{StaticResource LavenderBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StrengthLabel" Grid.Column="7" MinWidth="52" TextAlignment="Right" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" Text="—" Margin="10,0,0,0"/>
            </Grid>
            <ItemsControl x:Name="RulesList" Margin="0,8,0,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2,8,2">
                            <TextBlock x:Name="Mark" Text="&#xE738;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Width="16" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="RuleText" Text="{Binding Text}" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMet}" Value="True">
                                <Setter TargetName="Mark" Property="Text" Value="&#xE73E;"/>
                                <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                                <Setter TargetName="RuleText" Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
