<local:PageBase x:Class="ReportsView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:PetGroomingInventory">
    <local:PageBase.Resources>
        <!-- Headline figure above the report tables -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="MinWidth" Value="168"/>
        </Style>
        <Style x:Key="QuickRangeButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
    </local:PageBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Filters and actions ===================== -->
        <Border Style="{StaticResource Card}" Padding="20,16,20,12" Margin="0,0,0,14">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Width="250" Margin="0,0,14,8">
                        <TextBlock Style="{StaticResource LabelText}" Text="Report Type"/>
                        <ComboBox x:Name="TypeBox" DisplayMemberPath="Label" SelectionChanged="Type_Changed" ToolTip="The kind of inventory report to generate"/>
                    </StackPanel>
                    <StackPanel Width="170" Margin="0,0,14,8">
                        <TextBlock Style="{StaticResource LabelText}" Text="Inventory From"/>
                        <DatePicker x:Name="FromPicker" SelectedDateChanged="Date_Changed" ToolTip="First day of the reporting period"/>
                        <TextBlock x:Name="FromError" Style="{StaticResource ErrorText}"/>
                    </StackPanel>
                    <StackPanel Width="170" Margin="0,0,14,8">
                        <TextBlock Style="{StaticResource LabelText}" Text="Inventory To"/>
                        <DatePicker x:Name="ToPicker" SelectedDateChanged="Date_Changed" ToolTip="Last day of the reporting period (included)"/>
                        <TextBlock x:Name="ToError" Style="{StaticResource ErrorText}"/>
                    </StackPanel>
                    <StackPanel Width="210" Margin="0,0,14,8">
                        <TextBlock Style="{StaticResource LabelText}" Text="Category"/>
                        <ComboBox x:Name="CategoryBox" DisplayMemberPath="Label" ToolTip="Optional: limit the report to one category"/>
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource LabelText}" Text="Pet Type"/>
                        <ComboBox x:Name="PetTypeBox" DisplayMemberPath="Label" ToolTip="Optional: Dog and Cat also include Dog &amp; Cat items"/>
                    </StackPanel>
                </WrapPanel>

                <WrapPanel x:Name="QuickRangePanel">
                    <TextBlock Text="Quick range:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource QuickRangeButton}" Content="Today" Click="Today_Click"/>
                    <Button Style="{StaticResource QuickRangeButton}" Content="This Month" Click="ThisMonth_Click"/>
                    <Button Style="{StaticResource QuickRangeButton}" Content="Last Month" Click="LastMonth_Click"/>
                    <Button Style="{StaticResource QuickRangeButton}" Content="This Year" Click="ThisYear_Click"/>
                    <Button Style="{StaticResource QuickRangeButton}" Content="All Time" Click="AllTime_Click"
                            ToolTip="From the earliest to the latest date in your records"/>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE946;" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Top" Margin="0,1,8,0"/>
                    <TextBlock x:Name="DateHintText" Style="{StaticResource MutedText}"/>
                </StackPanel>
                <TextBlock x:Name="GeneralError" Style="{StaticResource ErrorText}"/>

                <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,12,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel>
                        <Button x:Name="GenerateButton" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4" Click="Generate_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" FontSize="12"/>
                                <TextBlock Text="Generate Report" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ResetButton" Style="{StaticResource GhostButton}" Margin="0,0,18,4" Click="Reset_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE894;" FontSize="12"/>
                                <TextBlock Text="Reset Filters" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PrintButton" Style="{StaticResource SecondaryButton}" Margin="0,0,8,4" Click="Print_Click" IsEnabled="False"
                                ToolTip="Print the generated report">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE749;"/>
                                <TextBlock Text="Print Report" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PdfButton" Style="{StaticResource SecondaryButton}" Margin="0,0,8,4" Click="Pdf_Click" IsEnabled="False"
                                ToolTip="Save the generated report as a PDF file">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8A5;"/>
                                <TextBlock Text="Export to PDF" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExcelButton" Style="{StaticResource SecondaryButton}" Margin="0,0,8,4" Click="Excel_Click" IsEnabled="False"
                                ToolTip="Save the generated report as an Excel workbook (.xlsx)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE80A;"/>
                                <TextBlock Text="Export to Excel" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <StackPanel x:Name="BusyPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE895;" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="Generating report…" Margin="8,0,4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===================== Generated report ===================== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <ScrollViewer x:Name="ReportScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="22,18,22,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ReportTitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PeriodText" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="FilterText" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DateBasisText" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="GeneratedText" Grid.Column="1" Style="{StaticResource MutedText}" TextWrapping="NoWrap"
                                       VerticalAlignment="Top" Margin="16,6,0,0"/>
                        </Grid>
                        <StackPanel x:Name="StatsPanel" Margin="0,16,0,4"/>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" FontSize="14" HorizontalAlignment="Center"
                                   TextAlignment="Center" Margin="0,30,0,30" MaxWidth="520" Visibility="Collapsed"/>
                        <StackPanel x:Name="TablesPanel"/>
                        <StackPanel x:Name="NotesPanel"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="PlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="24">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource LavenderBrush}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE9F9;" FontSize="26" Foreground="{StaticResource PrimaryDarkBrush}"/>
                    </Border>
                    <TextBlock Text="No report generated yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="13" TextAlignment="Center"
                               Text="Choose a report type, set Inventory From and Inventory To, then click Generate Report."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</local:PageBase>
