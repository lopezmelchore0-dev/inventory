<Window x:Class="ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" Width="660" Title="Add Item">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="28,24,18,0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource LavenderBrush}">
                    <TextBlock x:Name="HeaderIcon" Style="{StaticResource IconText}" Text="&#xE710;" FontSize="16" Foreground="{StaticResource PrimaryDarkBrush}"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="Add Item" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HeaderSubtitle" Text="Register a new product in the shop's inventory." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Top"
                    ToolTip="Close" Click="Cancel_Click"/>
        </Grid>

        <!-- Form -->
        <Grid Grid.Row="1" Margin="28,22,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Item name -->
            <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,14">
                <TextBlock Text="Item Name *" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="NameBox" Tag="e.g. Oatmeal Dog Shampoo 500ml" MaxLength="150"/>
                <TextBlock x:Name="NameError" Style="{StaticResource ErrorText}"/>
            </StackPanel>

            <!-- 2. Category / 3. Pet type -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="Category *" Style="{StaticResource LabelText}"/>
                <ComboBox x:Name="CategoryBox" Tag="Select a category" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="CategoryBox_SelectionChanged"/>
                <TextBlock x:Name="CategoryError" Style="{StaticResource ErrorText}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                <TextBlock Text="Pet Type *" Style="{StaticResource LabelText}"/>
                <ComboBox x:Name="PetTypeBox" Tag="Dog, Cat or Both?" DisplayMemberPath="Label" SelectedValuePath="Value"
                          ToolTip="Which animal this item is intended for"/>
                <TextBlock x:Name="PetTypeError" Style="{StaticResource ErrorText}"/>
            </StackPanel>

            <!-- 4. Description (size, flavor, color or variant: pick a suggestion or type anything) / 5. Quantity -->
            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock Text="Description (optional)" Style="{StaticResource LabelText}"/>
                <ComboBox x:Name="DescriptionBox" Style="{StaticResource EditableComboBox}" Tag="e.g. 500 ml, 15 g Pink, Lamb"
                          ToolTip="Size, measurement, flavor, color or variant. Pick a suggestion or type your own."/>
                <TextBlock x:Name="DescriptionError" Style="{StaticResource ErrorText}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                <TextBlock x:Name="QuantityLabel" Text="Quantity *" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="QuantityBox" Tag="0" MaxLength="12"
                         PreviewTextInput="Amount_PreviewTextInput" DataObject.Pasting="Amount_Pasting"/>
                <TextBlock x:Name="QuantityError" Style="{StaticResource ErrorText}"/>
                <TextBlock x:Name="QuantityHint" Style="{StaticResource MutedText}" FontSize="11.5" Margin="2,5,0,0" Visibility="Collapsed"
                           Text="To change the quantity, use Stock In or Stock Adjustment so the change is recorded."/>
            </StackPanel>

            <!-- 6. Retail price / 8. Expiration date -->
            <StackPanel Grid.Row="3" Margin="0,0,0,14">
                <TextBlock Text="Retail Price *" Style="{StaticResource LabelText}"/>
                <Grid>
                    <TextBox x:Name="PriceBox" Tag="0.00" Padding="32,9,12,9" MaxLength="12"
                             PreviewTextInput="Amount_PreviewTextInput" DataObject.Pasting="Amount_Pasting"/>
                    <TextBlock Text="&#x20B1;" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" IsHitTestVisible="False"/>
                </Grid>
                <TextBlock x:Name="PriceError" Style="{StaticResource ErrorText}"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,14">
                <TextBlock x:Name="ExpirationLabel" Text="Expiration Date (optional)" Style="{StaticResource LabelText}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker x:Name="ExpirationPicker" SelectedDateFormat="Short"/>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Clear" Margin="6,0,0,0" Click="ClearDate_Click"
                            ToolTip="Remove the expiration date"/>
                </Grid>
                <TextBlock x:Name="ExpirationError" Style="{StaticResource ErrorText}"/>
                <TextBlock x:Name="ExpirationHint" Style="{StaticResource MutedText}" FontSize="11.5" Margin="2,5,0,0"/>
            </StackPanel>

            <!-- 7. Supplier -->
            <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,0,0,14">
                <TextBlock Text="Supplier *" Style="{StaticResource LabelText}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="SupplierBox" Tag="Select a supplier" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="14,9" Click="NewSupplier_Click"
                            ToolTip="Add a supplier that is not in the list yet">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" FontSize="12"/>
                            <TextBlock Text="New supplier" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock x:Name="SupplierError" Style="{StaticResource ErrorText}"/>
                <TextBlock x:Name="NoSupplierHint" Style="{StaticResource MutedText}" FontSize="11.5" Margin="2,5,0,0" Visibility="Collapsed"
                           Text="No suppliers yet. Click “New supplier” to add one."/>
            </StackPanel>

            <!-- General error -->
            <Border Grid.Row="5" Grid.ColumnSpan="3" Margin="0,2,0,0" CornerRadius="10" Background="#FBEAF1" Padding="12,9"
                    Visibility="{Binding Visibility, ElementName=GeneralError}">
                <TextBlock x:Name="GeneralError" Style="{StaticResource ErrorText}" Margin="0"/>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancel" MinWidth="110" IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Save Item" MinWidth="130" Margin="10,0,0,0"
                        IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
