<local:PageBase x:Class="HelpView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:PetGroomingInventory"
                PreviewKeyDown="HelpView_PreviewKeyDown">
    <local:PageBase.Resources>
        <!-- "Read more" hint on a topic card: brightens when the card is hovered -->
        <Style x:Key="ReadMoreHint" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Rounded icon badge used on cards and section headers -->
        <Style x:Key="TopicIconBadge" TargetType="Border">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{StaticResource LavenderBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </local:PageBase.Resources>

    <Grid x:Name="LayoutRoot" SizeChanged="LayoutRoot_SizeChanged">

        <!-- ===================== Preview ===================== -->
        <ScrollViewer x:Name="PreviewPanel" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel>
                <!-- Intro banner -->
                <Border CornerRadius="22" Background="{StaticResource BannerBrush}" Padding="30,26">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="How can we help?" Foreground="White" FontSize="28" FontWeight="Bold"/>
                            <TextBlock x:Name="IntroText" Foreground="White" FontSize="14.5" Margin="0,10,0,0"
                                       TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" LineHeight="22"/>
                            <Button x:Name="ViewGuideButton" Style="{StaticResource SecondaryButton}" Margin="0,20,0,0"
                                    HorizontalAlignment="Left" Padding="20,11" Click="ViewGuide_Click"
                                    ToolTip="Open the complete Help &amp; Support guide">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE82D;"/>
                                    <TextBlock Text="View Full Guide" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Grid x:Name="BannerArt" Grid.Column="1" Width="160" Height="124" Margin="16,0,0,0">
                            <Ellipse Width="124" Height="124" Fill="#26FFFFFF" HorizontalAlignment="Right"/>
                            <Ellipse Width="52" Height="52" Fill="#1AFFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE897;" FontSize="54" Foreground="White"
                                       HorizontalAlignment="Right" Margin="0,0,35,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Topic cards -->
                <TextBlock Text="Browse topics" Style="{StaticResource CardTitleText}" FontSize="18" Margin="2,26,0,2"/>
                <TextBlock Text="Choose a topic to open it in the full guide." Style="{StaticResource MutedText}" Margin="2,0,0,6"/>
                <ItemsControl x:Name="TopicList" Margin="-8,0,-8,8" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding TopicColumns, RelativeSource={RelativeSource AncestorType=local:HelpView}}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource HelpTopicCard}" Tag="{Binding}" Click="Topic_Click"
                                    AutomationProperties.Name="{Binding Title}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Style="{StaticResource TopicIconBadge}">
                                        <TextBlock Style="{StaticResource IconText}" Text="{Binding Icon}" FontSize="18"
                                                   Foreground="{StaticResource PrimaryDarkBrush}"/>
                                    </Border>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,14,0,4"/>
                                    <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource ReadMoreHint}" Margin="0,14,0,0">
                                        <TextBlock Text="Read more" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryDarkBrush}"/>
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE72A;" FontSize="11" Margin="6,1,0,0"
                                                   Foreground="{StaticResource PrimaryDarkBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}" FontSize="13" TextWrapping="Wrap" LineHeight="19"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Full guide ===================== -->
        <Grid x:Name="GuidePanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Style="{StaticResource SecondaryButton}" Click="BackToOverview_Click"
                            Padding="14,9" ToolTip="Return to the Help &amp; Support overview (Esc)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE72B;" FontSize="12"/>
                            <TextBlock Text="Back to Overview" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Full Guide" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Every Help &amp; Support topic in one place." Style="{StaticResource MutedText}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TocColumn" Width="240"/>
                    <ColumnDefinition x:Name="TocGap" Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Table of contents -->
                <Border x:Name="TocPanel" Style="{StaticResource Card}" Padding="12,16" VerticalAlignment="Top">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <TextBlock Text="ON THIS PAGE" Style="{StaticResource TableHeaderText}" Margin="12,0,0,8"/>
                            <ItemsControl x:Name="TocList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" Tag="{Binding}" Click="Topic_Click"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Normal" FontSize="13"
                                                Padding="12,8" Margin="0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource IconText}" Text="{Binding Icon}" FontSize="13"
                                                           HorizontalAlignment="Left" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" Margin="6,0,0,0"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Sections -->
                <ScrollViewer x:Name="GuideScroll" Grid.Column="2" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel x:Name="GuideContent">
                        <ItemsControl x:Name="GuideSections" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="26,24" Margin="0,0,0,16">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource TopicIconBadge}" Width="40" Height="40" CornerRadius="13">
                                                    <TextBlock Style="{StaticResource IconText}" Text="{Binding Icon}" FontSize="16"
                                                               Foreground="{StaticResource PrimaryDarkBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Intro}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13.5"
                                                       TextWrapping="Wrap" LineHeight="21" Margin="0,14,0,0"/>

                                            <ItemsControl ItemsSource="{Binding Bullets}" Focusable="False" Margin="0,10,0,0"
                                                          Visibility="{Binding HasBullets, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,6,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Width="6" Height="6" Fill="{StaticResource PrimaryBrush}"
                                                                     VerticalAlignment="Top" Margin="4,8,12,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" LineHeight="21" FontSize="13.5"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl ItemsSource="{Binding Faqs}" Focusable="False" Margin="0,6,0,0"
                                                          Visibility="{Binding HasFaqs, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="14" Padding="18,14"
                                                                Margin="0,10,0,0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Question}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Answer}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Button Style="{StaticResource LinkButton}" Content="Back to top" Click="BackToTop_Click"/>
                            <TextBlock Text="·" Foreground="{StaticResource TextMutedBrush}" Margin="8,0" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource LinkButton}" Content="Back to Overview" Click="BackToOverview_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</local:PageBase>
