<local:PageBase x:Class="ChangePasswordView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:PetGroomingInventory">
    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel HorizontalAlignment="Left" Width="560">
            <Button x:Name="BackToProfileButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,0,0,12"
                    Click="BackToProfile_Click" AutomationProperties.Name="Back to Profile">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72B;" FontSize="12"/>
                    <TextBlock Text="Back to Profile" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>

            <Border Style="{StaticResource Card}" Padding="28">
                <StackPanel x:Name="Form">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource LavenderBrush}">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE72E;" FontSize="16" Foreground="{StaticResource PrimaryDarkBrush}"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Change Password" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock Text="Enter your current password, then choose a new one." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,22,0,14">
                        <TextBlock Text="Current Password" Style="{StaticResource LabelText}"/>
                        <local:PasswordField x:Name="CurrentInput" Placeholder="Enter your current password" AutomationProperties.Name="Current Password"/>
                        <TextBlock x:Name="CurrentError" Style="{StaticResource ErrorText}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="New Password" Style="{StaticResource LabelText}"/>
                        <local:PasswordField x:Name="NewInput" Placeholder="Create a new password" ShowStrength="True" AutomationProperties.Name="New Password"/>
                        <TextBlock x:Name="NewError" Style="{StaticResource ErrorText}"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Confirm New Password" Style="{StaticResource LabelText}"/>
                        <local:PasswordField x:Name="ConfirmInput" Placeholder="Re-enter the new password" AutomationProperties.Name="Confirm New Password"/>
                        <TextBlock x:Name="ConfirmError" Style="{StaticResource ErrorText}"/>
                    </StackPanel>

                    <Border x:Name="SuccessBorder" Style="{StaticResource NoticeBox}" Background="{StaticResource LavenderBrush}"
                            Margin="0,16,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE73E;" Foreground="{StaticResource PrimaryDarkBrush}"/>
                            <TextBlock x:Name="SuccessText" Text="Password changed successfully." Margin="10,0,0,0" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryDarkBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource NoticeBox}" Margin="0,16,0,0" Visibility="{Binding Visibility, ElementName=GeneralError}">
                        <TextBlock x:Name="GeneralError" Style="{StaticResource ErrorText}" Margin="0" FontSize="13"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel" MinWidth="110" Click="BackToProfile_Click"/>
                        <Button x:Name="ChangeButton" Style="{StaticResource PrimaryButton}" Content="Change Password" MinWidth="150"
                                Margin="10,0,0,0" Click="Change_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:PageBase>
