<local:PageBase x:Class="SuppliersView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:PetGroomingInventory">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="300">
                <TextBox x:Name="SearchBox" Tag="Search name, contact, phone or address…" Padding="40,9,12,9"
                         TextChanged="Search_TextChanged" MaxLength="120"/>
                <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" HorizontalAlignment="Left" Margin="15,0,0,0"
                           Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False"/>
            </Grid>
            <TextBlock x:Name="CountText" Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="AddSupplier_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE710;"/>
                    <TextBlock Text="Add Supplier" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,4,8,8">
            <Grid>
                <DataGrid x:Name="SuppliersGrid" MouseDoubleClick="SuppliersGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Supplier Name" Width="1.6*" MinWidth="170" SortMemberPath="Name"
                                                CellTemplate="{StaticResource ItemNameTemplate}"/>
                        <DataGridTextColumn Header="Contact Person" Width="1.2*" MinWidth="120" Binding="{Binding ContactPerson}"
                                            ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Phone Number" Width="1*" MinWidth="120" Binding="{Binding Phone}"
                                            ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Header="Address" Width="2*" MinWidth="160" SortMemberPath="Address">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Address}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Address}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Email" Width="1.3*" MinWidth="120" Binding="{Binding EmailText, Mode=OneWay}"
                                            SortMemberPath="Email" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Items Supplied" Width="0.9*" MinWidth="100" Binding="{Binding ItemCountText, Mode=OneWay}"
                                            SortMemberPath="ItemCount" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Header="Actions" Width="90" MinWidth="90" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Edit supplier" Click="EditRow_Click"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete supplier" Click="DeleteRow_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="380">
                    <Border Width="84" Height="84" CornerRadius="42" Background="{StaticResource LavenderBrush}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE716;" FontSize="32" Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>
                    <TextBlock x:Name="EmptyTitle" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                    <TextBlock x:Name="EmptyMessage" Style="{StaticResource MutedText}" FontSize="13" TextAlignment="Center"/>
                    <Button x:Name="EmptyActionButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                            Click="EmptyAction_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</local:PageBase>
