<UserControl x:Class="RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PetGroomingInventory">
    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border x:Name="FormCard" Style="{StaticResource AuthCard}" MaxWidth="500">
            <Grid>
                <!-- ===================== Form ===================== -->
                <StackPanel x:Name="FormPanel">
                    <local:AuthBrand Title="Create Admin Account"
                                     Subtitle="Set up the Admin account that manages this shop's inventory."/>

                    <StackPanel Margin="0,20,0,14">
                        <TextBlock Text="Full Name" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="FullNameBox" Tag="e.g. Maria Santos" MaxLength="100" AutomationProperties.Name="Full Name"/>
                        <TextBlock x:Name="FullNameError" Style="{StaticResource ErrorText}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Username" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="UsernameBox" Tag="4–30 letters, numbers, . or _" MaxLength="30" InputScope="LogOnName"
                                 TextChanged="UsernameBox_TextChanged" AutomationProperties.Name="Username"/>
                        <TextBlock x:Name="UsernameError" Style="{StaticResource ErrorText}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Password" Style="{StaticResource LabelText}"/>
                        <local:PasswordField x:Name="PasswordInput" Placeholder="Create a strong password" ShowStrength="True"
                                             AutomationProperties.Name="Password"/>
                        <TextBlock x:Name="PasswordError" Style="{StaticResource ErrorText}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Confirm Password" Style="{StaticResource LabelText}"/>
                        <local:PasswordField x:Name="ConfirmInput" Placeholder="Re-enter the password"
                                             AutomationProperties.Name="Confirm Password"/>
                        <TextBlock x:Name="ConfirmError" Style="{StaticResource ErrorText}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Security Question" Style="{StaticResource LabelText}"/>
                        <ComboBox x:Name="QuestionBox" Tag="Choose a question" AutomationProperties.Name="Security Question"/>
                        <TextBlock x:Name="QuestionError" Style="{StaticResource ErrorText}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Security Answer" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="AnswerBox" Tag="Your answer (not case-sensitive)" MaxLength="100" AutomationProperties.Name="Security Answer"/>
                        <TextBlock x:Name="AnswerError" Style="{StaticResource ErrorText}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="2,6,0,0"
                                   Text="Used to reset your password if you forget it. Pick an answer only you know."/>
                    </StackPanel>

                    <Border Style="{StaticResource NoticeBox}" Margin="0,0,0,14" Visibility="{Binding Visibility, ElementName=GeneralError}">
                        <TextBlock x:Name="GeneralError" Style="{StaticResource ErrorText}" Margin="0" FontSize="13"/>
                    </Border>

                    <Button x:Name="CreateButton" Style="{StaticResource PrimaryButton}" Content="Create Admin Account" Padding="18,12"
                            HorizontalAlignment="Stretch" Click="Create_Click"/>

                    <WrapPanel x:Name="LoginLinkPanel" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <TextBlock Text="Already have an account?" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource LinkButton}" Content="Login" FontWeight="SemiBold" Margin="2,0,0,0" Click="BackToLogin_Click"/>
                    </WrapPanel>
                </StackPanel>

                <!-- ===================== Success ===================== -->
                <StackPanel x:Name="SuccessPanel" Visibility="Collapsed">
                    <local:AuthBrand Title="All set!" Subtitle=""/>
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource LavenderBrush}"
                            HorizontalAlignment="Left" Margin="0,22,0,0">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE73E;" FontSize="26" Foreground="{StaticResource PrimaryDarkBrush}"/>
                    </Border>
                    <TextBlock x:Name="SuccessText" Text="Admin account created successfully." FontSize="17" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,16,0,6"/>
                    <TextBlock x:Name="SuccessDetail" Style="{StaticResource MutedText}" FontSize="13"/>
                    <Button x:Name="ProceedButton" Style="{StaticResource PrimaryButton}" Content="Proceed to Login" Padding="18,12"
                            HorizontalAlignment="Stretch" Margin="0,24,0,0" Click="Proceed_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
