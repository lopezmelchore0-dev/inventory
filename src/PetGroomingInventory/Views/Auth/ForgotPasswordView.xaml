<UserControl x:Class="ForgotPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PetGroomingInventory">
    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border x:Name="FormCard" Style="{StaticResource AuthCard}" MaxWidth="480">
            <StackPanel>
                <local:AuthBrand x:Name="Brand" Title="Forgot Password"
                                 Subtitle="Answer your security question to set a new password."/>

                <!-- Step indicator -->
                <Grid Margin="0,20,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StepBar1" Height="4" CornerRadius="2" Background="{StaticResource AccentButtonBrush}"/>
                    <Border x:Name="StepBar2" Grid.Column="2" Height="4" CornerRadius="2" Background="{StaticResource LavenderBrush}"/>
                    <Border x:Name="StepBar3" Grid.Column="4" Height="4" CornerRadius="2" Background="{StaticResource LavenderBrush}"/>
                </Grid>
                <TextBlock x:Name="StepText" Style="{StaticResource MutedText}" Text="Step 1 of 3 · Username" Margin="0,0,0,16"/>

                <!-- Step 1: username -->
                <StackPanel x:Name="Step1Panel">
                    <TextBlock Text="Username" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="UsernameBox" Tag="Enter your username" MaxLength="30" InputScope="LogOnName" AutomationProperties.Name="Username"/>
                    <TextBlock x:Name="UsernameError" Style="{StaticResource ErrorText}"/>
                </StackPanel>

                <!-- Step 2: security question -->
                <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <TextBlock Text="Security Question" Style="{StaticResource LabelText}"/>
                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="14,11" Margin="0,0,0,14">
                        <TextBlock x:Name="QuestionText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="Security Answer" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="AnswerBox" Tag="Your answer (not case-sensitive)" MaxLength="100" AutomationProperties.Name="Security Answer"/>
                    <TextBlock x:Name="AnswerError" Style="{StaticResource ErrorText}"/>
                </StackPanel>

                <!-- Step 3: new password -->
                <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="New Password" Style="{StaticResource LabelText}"/>
                        <local:PasswordField x:Name="NewPasswordInput" Placeholder="Create a new password" ShowStrength="True"
                                             AutomationProperties.Name="New Password"/>
                        <TextBlock x:Name="NewPasswordError" Style="{StaticResource ErrorText}"/>
                    </StackPanel>
                    <TextBlock Text="Confirm New Password" Style="{StaticResource LabelText}"/>
                    <local:PasswordField x:Name="ConfirmInput" Placeholder="Re-enter the new password"
                                         AutomationProperties.Name="Confirm New Password"/>
                    <TextBlock x:Name="ConfirmError" Style="{StaticResource ErrorText}"/>
                </StackPanel>

                <!-- Done -->
                <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource LavenderBrush}" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE73E;" FontSize="26" Foreground="{StaticResource PrimaryDarkBrush}"/>
                    </Border>
                    <TextBlock Text="Password reset successfully. You can now log in with your new password."
                               FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,6"/>
                    <TextBlock x:Name="RedirectText" Style="{StaticResource MutedText}" FontSize="13" Text="Taking you to Login…"/>
                </StackPanel>

                <Border Style="{StaticResource NoticeBox}" Margin="0,16,0,0" Visibility="{Binding Visibility, ElementName=GeneralError}">
                    <TextBlock x:Name="GeneralError" Style="{StaticResource ErrorText}" Margin="0" FontSize="13"/>
                </Border>

                <Button x:Name="ActionButton" Style="{StaticResource PrimaryButton}" Content="Continue" Padding="18,12"
                        HorizontalAlignment="Stretch" Margin="0,20,0,0" Click="Action_Click"/>

                <Button x:Name="BackToLoginButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,18,0,0"
                        Click="BackToLogin_Click" AutomationProperties.Name="Back to Login">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE72B;" FontSize="12"/>
                        <TextBlock Text="Back to Login" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
