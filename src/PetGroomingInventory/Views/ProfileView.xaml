<local:PageBase x:Class="ProfileView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:PetGroomingInventory">
    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== Account summary ===================== -->
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Left">
                            <TextBlock x:Name="InitialsText" Text="A" FontSize="26" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="FullNameText" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,2" TextWrapping="Wrap"/>
                        <TextBlock x:Name="UsernameText" Foreground="{StaticResource TextSecondaryBrush}"/>

                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="14" Padding="16,12" Margin="0,18,0,0"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Full Name" Style="{StaticResource MutedText}" Margin="0,4,16,4"/>
                                <TextBlock x:Name="SummaryFullName" Grid.Column="1" FontWeight="SemiBold" Margin="0,4" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="1" Text="Username" Style="{StaticResource MutedText}" Margin="0,4,16,4"/>
                                <TextBlock x:Name="SummaryUsername" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Margin="0,4" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="2" Text="Role" Style="{StaticResource MutedText}" Margin="0,4,16,4" VerticalAlignment="Center"/>
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource StatusBadge}" Background="{StaticResource LavenderBrush}" Margin="0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE83D;" FontSize="11" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                        <TextBlock x:Name="RoleText" Text="Admin" Style="{StaticResource BadgeText}" Margin="6,0,0,0"
                                                   Foreground="{StaticResource PrimaryDarkBrush}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Row="3" Text="Last login" Style="{StaticResource MutedText}" Margin="0,4,16,4"/>
                                <TextBlock x:Name="LastLoginText" Grid.Row="3" Grid.Column="1" Margin="0,4" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="24" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Security" Style="{StaticResource CardTitleText}"/>
                        <TextBlock x:Name="PasswordChangedText" Style="{StaticResource MutedText}" Margin="0,4,0,14"/>
                        <Button x:Name="ChangePasswordButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                                Click="ChangePassword_Click" AutomationProperties.Name="Change Password">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE72E;"/>
                                <TextBlock Text="Change Password" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddAdminButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                                Click="AddAdmin_Click" AutomationProperties.Name="Add Admin Account">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8FA;"/>
                                <TextBlock Text="Add Admin Account" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================== Edit profile ===================== -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24" VerticalAlignment="Top">
                <StackPanel x:Name="EditForm">
                    <TextBlock Text="Account Settings" Style="{StaticResource CardTitleText}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,18"
                               Text="Update your details and security question. Your role is always Admin. To change your password, use Change Password."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Full Name" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="FullNameBox" MaxLength="100" AutomationProperties.Name="Full Name"/>
                            <TextBlock x:Name="FullNameError" Style="{StaticResource ErrorText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,0,14">
                            <TextBlock Text="Username" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="UsernameBox" MaxLength="30" AutomationProperties.Name="Username"/>
                            <TextBlock x:Name="UsernameError" Style="{StaticResource ErrorText}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Role" Style="{StaticResource LabelText}"/>
                        <TextBox Text="Admin" IsReadOnly="True" Focusable="False" ToolTip="Every account is an Admin. The role cannot be changed."/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Security Question" Style="{StaticResource LabelText}"/>
                        <ComboBox x:Name="QuestionBox" AutomationProperties.Name="Security Question"/>
                        <TextBlock x:Name="QuestionError" Style="{StaticResource ErrorText}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="New Security Answer" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="AnswerBox" MaxLength="100" Tag="Leave blank to keep your current answer"
                                 AutomationProperties.Name="New Security Answer"/>
                        <TextBlock x:Name="AnswerError" Style="{StaticResource ErrorText}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="2,6,0,0"
                                   Text="Your current answer is never shown. Required if you change the question."/>
                    </StackPanel>

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="14" Padding="16,14" Margin="0,4,0,0"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Current Password" Style="{StaticResource LabelText}"/>
                            <local:PasswordField x:Name="CurrentPasswordInput" Placeholder="Required to save changes"
                                                 AutomationProperties.Name="Current Password"/>
                            <TextBlock x:Name="CurrentPasswordError" Style="{StaticResource ErrorText}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource NoticeBox}" Margin="0,14,0,0" Visibility="{Binding Visibility, ElementName=GeneralError}">
                        <TextBlock x:Name="GeneralError" Style="{StaticResource ErrorText}" Margin="0" FontSize="13"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Discard Changes" MinWidth="130" Click="Discard_Click"/>
                        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Save Changes" MinWidth="130"
                                Margin="10,0,0,0" Click="Save_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</local:PageBase>
