<Window x:Class="MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" Width="500" Title="Message">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="28,28,28,22" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="IconCircle" Width="48" Height="48" CornerRadius="24" Background="{StaticResource LavenderBrush}" VerticalAlignment="Top">
                <TextBlock x:Name="IconGlyph" Style="{StaticResource IconText}" FontSize="20" Text="&#xE946;"
                           Foreground="{StaticResource PrimaryDarkBrush}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="16,2,0,0">
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="MessageText" Margin="0,8,0,0" FontSize="13.5" LineHeight="21" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SecondaryButton" Style="{StaticResource SecondaryButton}" MinWidth="104" IsCancel="True"
                        Content="Cancel" Click="Secondary_Click"/>
                <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" MinWidth="104" Margin="10,0,0,0"
                        IsDefault="True" Content="OK" Click="Primary_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
