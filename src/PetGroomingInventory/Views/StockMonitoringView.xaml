<local:PageBase x:Class="StockMonitoringView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:PetGroomingInventory">
    <local:PageBase.Resources>
        <!-- Status chip in the summary row -->
        <Style x:Key="ChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        </Style>
    </local:PageBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status summary + actions -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel VerticalAlignment="Center">
                <Border Style="{StaticResource ChipBorder}" Margin="0,0,10,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource InStockBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="In Stock" Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="InStockCount" Text="0" FontWeight="Bold" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipBorder}" Margin="0,0,10,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource LowStockBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Low Stock" Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="LowCount" Text="0" FontWeight="Bold" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipBorder}" Margin="0,0,10,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource CriticalStockBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Critical Stock" Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="CriticalCount" Text="0" FontWeight="Bold" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipBorder}" Margin="0,0,10,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource OutOfStockBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Out of Stock" Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="OutCount" Text="0" FontWeight="Bold" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="RulesText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="4,0,0,6" TextWrapping="NoWrap"/>
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource SecondaryButton}" Click="Adjust_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8EF;"/>
                        <TextBlock Text="Stock Adjustment" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="StockIn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE896;"/>
                        <TextBlock Text="Stock In" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16">
            <TabControl x:Name="Tabs" Style="{StaticResource PillTabControl}">

                <!-- Needs restocking -->
                <TabItem x:Name="RestockTab" Header="Needs Restocking">
                    <Grid>
                        <DataGrid x:Name="RestockGrid">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Item Name" Width="2*" MinWidth="170" SortMemberPath="Name" CellTemplate="{StaticResource ItemNameTemplate}"/>
                                <DataGridTextColumn Header="Category" Width="1.2*" MinWidth="110" Binding="{Binding CategoryName}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Available Stock" Width="1*" MinWidth="110" SortMemberPath="Quantity"
                                                    Binding="{Binding QuantityText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Supplier" Width="1.4*" MinWidth="120" Binding="{Binding SupplierName}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTemplateColumn Header="Status" Width="1.1*" MinWidth="128" SortMemberPath="Status" CellTemplate="{StaticResource StockBadgeTemplate}"/>
                                <DataGridTemplateColumn Header="Action" Width="120" MinWidth="120" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12.5" Click="RestockRow_Click"
                                                    ToolTip="Record stock received for this item">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE896;" FontSize="12"/>
                                                    <TextBlock Text="Restock" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="RestockEmpty" Style="{StaticResource MutedText}" FontSize="13.5" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </TabItem>

                <!-- Expiration alerts -->
                <TabItem x:Name="ExpiryTab" Header="Expiration Alerts">
                    <Grid>
                        <DataGrid x:Name="ExpiryGrid">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Item Name" Width="2*" MinWidth="170" SortMemberPath="Name" CellTemplate="{StaticResource ItemNameTemplate}"/>
                                <DataGridTextColumn Header="Category" Width="1.2*" MinWidth="110" Binding="{Binding CategoryName}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Available Stock" Width="1*" MinWidth="110" SortMemberPath="Quantity"
                                                    Binding="{Binding QuantityText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Expiration Date" Width="1.1*" MinWidth="110" SortMemberPath="ExpirationDate"
                                                    Binding="{Binding ExpirationText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Time Left" Width="1.1*" MinWidth="110" SortMemberPath="DaysToExpiration"
                                                    Binding="{Binding ExpirationDetail, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTemplateColumn Header="Status" Width="1*" MinWidth="120" SortMemberPath="ExpiryStatus" CellTemplate="{StaticResource ExpiryBadgeTemplate}"/>
                                <DataGridTemplateColumn Header="Action" Width="120" MinWidth="120" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12.5" Click="AdjustRow_Click"
                                                    ToolTip="Deduct disposed or expired stock">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8EF;" FontSize="12"/>
                                                    <TextBlock Text="Adjust" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="ExpiryEmpty" Style="{StaticResource MutedText}" FontSize="13.5" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </TabItem>

                <!-- Stock-in history -->
                <TabItem Header="Stock-In History">
                    <Grid>
                        <DataGrid x:Name="StockInGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date Received" Width="1*" MinWidth="110" SortMemberPath="TxnDate"
                                                    Binding="{Binding TxnDateText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Item" Width="1.8*" MinWidth="150" Binding="{Binding ItemName}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Type" Width="0.9*" MinWidth="100" Binding="{Binding TypeLabel, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Qty Received" Width="0.9*" MinWidth="90" SortMemberPath="QtyChange"
                                                    Binding="{Binding ChangeText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Unit" Width="0.6*" MinWidth="70" SortMemberPath="Unit"
                                                    Binding="{Binding UnitText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Stock" Width="0.9*" MinWidth="90" Binding="{Binding BeforeAfterText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Supplier" Width="1.4*" MinWidth="120" Binding="{Binding SupplierText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Note" Width="1.5*" MinWidth="110" Binding="{Binding NoteText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Recorded" Width="1.3*" MinWidth="140" SortMemberPath="CreatedAt"
                                                    Binding="{Binding CreatedAtText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="StockInEmpty" Style="{StaticResource MutedText}" FontSize="13.5" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Visibility="Collapsed" Text="No stock has been received yet."/>
                    </Grid>
                </TabItem>

                <!-- Adjustment history -->
                <TabItem Header="Adjustment History">
                    <Grid>
                        <DataGrid x:Name="AdjustmentGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Width="1*" MinWidth="110" SortMemberPath="TxnDate"
                                                    Binding="{Binding TxnDateText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Item" Width="1.8*" MinWidth="150" Binding="{Binding ItemName}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Change" Width="0.8*" MinWidth="80" SortMemberPath="QtyChange"
                                                    Binding="{Binding ChangeText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Unit" Width="0.6*" MinWidth="70" SortMemberPath="Unit"
                                                    Binding="{Binding UnitText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Stock" Width="0.9*" MinWidth="90" Binding="{Binding BeforeAfterText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Reason" Width="1.4*" MinWidth="130" Binding="{Binding ReasonText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Note" Width="1.6*" MinWidth="120" Binding="{Binding NoteText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Recorded" Width="1.3*" MinWidth="140" SortMemberPath="CreatedAt"
                                                    Binding="{Binding CreatedAtText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="AdjustmentEmpty" Style="{StaticResource MutedText}" FontSize="13.5" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Visibility="Collapsed" Text="No stock adjustments have been made yet."/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</local:PageBase>
