<local:PageBase x:Class="SettingsView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:PetGroomingInventory">
    <local:PageBase.Resources>
        <DataTemplate x:Key="LookupRowTemplate">
            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="2,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding UsageText, Mode=OneWay}" Style="{StaticResource MutedText}" FontSize="11.5"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove" Click="RemoveLookup_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
    </local:PageBase.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== Left column ===================== -->
            <StackPanel>
                <!-- Stock status rules -->
                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Stock Status Rules" Style="{StaticResource CardTitleText}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,16"
                                   Text="Statuses update automatically everywhere when these values change. The critical threshold must be lower than the low-stock threshold."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Low stock at or below" Style="{StaticResource LabelText}" TextTrimming="CharacterEllipsis"/>
                                <TextBox x:Name="LowBox" MaxLength="6" TextChanged="Rules_TextChanged"/>
                                <TextBlock x:Name="LowError" Style="{StaticResource ErrorText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Critical at or below" Style="{StaticResource LabelText}" TextTrimming="CharacterEllipsis"/>
                                <TextBox x:Name="CriticalBox" MaxLength="6" TextChanged="Rules_TextChanged"/>
                                <TextBlock x:Name="CriticalError" Style="{StaticResource ErrorText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Expiring soon (days)" Style="{StaticResource LabelText}" TextTrimming="CharacterEllipsis"/>
                                <TextBox x:Name="DaysBox" MaxLength="3" TextChanged="Rules_TextChanged"/>
                                <TextBlock x:Name="DaysError" Style="{StaticResource ErrorText}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Live legend -->
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="14" Padding="16,12" Margin="0,16,0,0"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource InStockBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="In Stock" FontWeight="SemiBold" Width="110" Margin="10,0,0,0"/>
                                    <TextBlock x:Name="InStockRule" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource LowStockBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Low Stock" FontWeight="SemiBold" Width="110" Margin="10,0,0,0"/>
                                    <TextBlock x:Name="LowRule" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource CriticalStockBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Critical Stock" FontWeight="SemiBold" Width="110" Margin="10,0,0,0"/>
                                    <TextBlock x:Name="CriticalRule" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource OutOfStockBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Out of Stock" FontWeight="SemiBold" Width="110" Margin="10,0,0,0"/>
                                    <TextBlock Text="quantity is 0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource PrimaryButton}" Content="Save Rules" HorizontalAlignment="Left" MinWidth="130"
                                Margin="0,16,0,0" Click="SaveRules_Click"/>
                    </StackPanel>
                </Border>

                <!-- Categories -->
                <Border Style="{StaticResource Card}" Padding="24" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Categories" Style="{StaticResource CardTitleText}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,16"
                                   Text="This list feeds the Category choices in the Add Item form. Categories in use cannot be removed."/>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Categories" Style="{StaticResource LabelText}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewCategoryBox" Tag="New category" MaxLength="80" KeyDown="NewCategoryBox_KeyDown"/>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Add" Margin="8,0,0,0" Padding="14,9" Click="AddCategory_Click"/>
                                </Grid>
                                <TextBlock x:Name="CategoryError" Style="{StaticResource ErrorText}"/>
                                <ItemsControl x:Name="CategoryList" Margin="0,8,0,0" ItemTemplate="{StaticResource LookupRowTemplate}" Tag="Category"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================== Right column ===================== -->
            <StackPanel Grid.Column="2">
                <!-- Backup and restore -->
                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource LavenderBrush}">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8F7;" Foreground="{StaticResource PrimaryDarkBrush}"/>
                            </Border>
                            <TextBlock Text="Backup &amp; Restore" Style="{StaticResource CardTitleText}" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0"
                                   Text="A backup contains all inventory items, suppliers, categories, units, stock history, activity history and settings, saved as a single .json file."/>
                        <TextBlock x:Name="LastBackupText" FontSize="12.5" Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,8" Click="Backup_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE896;"/>
                                    <TextBlock Text="Create Backup" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,8" Click="Restore_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE898;"/>
                                    <TextBlock Text="Restore from Backup" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,0,8" Content="Open backup folder" Click="OpenBackupFolder_Click"/>
                        </WrapPanel>
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="14,10" Margin="0,8,0,0"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <TextBlock Style="{StaticResource MutedText}" FontSize="12"
                                       Text="Restoring replaces ALL current data with the backup. The file is checked first, and a safety copy of your current data is saved automatically before anything is replaced."/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- General -->
                <Border Style="{StaticResource Card}" Padding="24" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource CardTitleText}"/>
                        <TextBlock Text="Application name" Style="{StaticResource LabelText}" Margin="0,14,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AppNameBox" MaxLength="40" Tag="e.g. PawStock"/>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Save" Margin="8,0,0,0" Padding="16,9" Click="SaveAppName_Click"/>
                        </Grid>
                        <TextBlock x:Name="AppNameError" Style="{StaticResource ErrorText}"/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" Text="Shown in the sidebar and the window title."/>

                        <TextBlock Text="Database connection" Style="{StaticResource LabelText}" Margin="0,18,0,6"/>
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="14,10"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="DbInfoText" FontSize="12.5" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DbFileText" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Sample data -->
                <Border Style="{StaticResource Card}" Padding="24" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Sample Data" Style="{StaticResource CardTitleText}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                   Text="Load demonstration items and suppliers to explore the system. Sample records are tagged SAMPLE and can be edited or removed like any other record."/>
                        <TextBlock x:Name="SampleStatusText" FontSize="12.5" Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <WrapPanel Margin="0,14,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="Load Sample Data" Margin="0,0,10,8" Click="LoadSamples_Click"/>
                            <Button Style="{StaticResource GhostButton}" Content="Remove Sample Data" Margin="0,0,0,8" Click="RemoveSamples_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</local:PageBase>
