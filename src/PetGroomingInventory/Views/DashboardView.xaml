<local:PageBase x:Class="DashboardView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:PetGroomingInventory">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <Grid x:Name="LayoutRoot" SizeChanged="LayoutRoot_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SideColumn" Width="320"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===================== Main column ===================== -->
            <StackPanel x:Name="MainColumn" Grid.Column="0">

                <!-- Greeting banner -->
                <Border CornerRadius="22" Background="{StaticResource BannerBrush}" Padding="30,24" MinHeight="168">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="GreetingText" Text="Hello!" Foreground="White" FontSize="30" FontWeight="Bold"/>
                            <TextBlock x:Name="DateText" Foreground="#FDE8F3" FontSize="13.5" Margin="0,4,0,0"/>
                            <TextBlock x:Name="BannerSummaryText" Foreground="White" FontSize="14.5" Margin="0,14,0,0"
                                       TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Grid Grid.Column="1" Width="180" Height="124" Margin="16,0,0,0" x:Name="BannerArt">
                            <Ellipse Width="124" Height="124" Fill="#26FFFFFF" HorizontalAlignment="Right"/>
                            <Ellipse Width="58" Height="58" Fill="#1AFFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                            <Path Data="{StaticResource PawGeometry}" Fill="White" Stretch="Uniform" Width="70" Height="70"
                                  HorizontalAlignment="Right" Margin="0,0,27,0"/>
                            <Path Data="{StaticResource PawGeometry}" Fill="#8CFFFFFF" Stretch="Uniform" Width="28" Height="28"
                                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,8,0,0">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="-24" CenterX="14" CenterY="14"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Quick actions (like the reference action bar) -->
                <Border Background="{StaticResource GlassBrush}" CornerRadius="20" Padding="8" Margin="0,16,0,0"
                        BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                    <UniformGrid Rows="1">
                        <Button Style="{StaticResource QuickActionButton}" Click="QuickAddItem_Click">
                            <StackPanel>
                                <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource LavenderBrush}">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" FontSize="16" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                </Border>
                                <TextBlock Text="Add Item" FontSize="12.5" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource QuickActionButton}" Click="QuickStockIn_Click">
                            <StackPanel>
                                <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource LavenderBrush}">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE896;" FontSize="16" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                </Border>
                                <TextBlock Text="Stock In" FontSize="12.5" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource QuickActionButton}" Click="QuickAlerts_Click">
                            <StackPanel>
                                <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource LavenderBrush}">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xEA8F;" FontSize="16" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                </Border>
                                <TextBlock Text="Stock Alerts" FontSize="12.5" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource QuickActionButton}" Click="QuickSuppliers_Click">
                            <StackPanel>
                                <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource LavenderBrush}">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE716;" FontSize="16" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                </Border>
                                <TextBlock Text="Suppliers" FontSize="12.5" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Border>

                <!-- Summary cards -->
                <UniformGrid x:Name="SummaryGrid" Columns="3" Margin="-6,10,-6,0">
                    <Button Style="{StaticResource SummaryCard}" Click="CardTotal_Click" ToolTip="Open the full inventory">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource LavenderBrush}" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE7B8;" Foreground="{StaticResource PrimaryDarkBrush}"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0">
                                <TextBlock x:Name="TotalItemsValue" Text="0" FontSize="26" FontWeight="Bold" Margin="0,-4,0,0"/>
                                <TextBlock Text="Total Items" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Distinct products" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource SummaryCard}" Click="CardTotal_Click" ToolTip="Open the full inventory">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource LavenderBrush}" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8FD;" Foreground="{StaticResource PrimaryDarkBrush}"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0">
                                <TextBlock x:Name="AvailableStockValue" Text="0" FontSize="26" FontWeight="Bold" Margin="0,-4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Available Stock" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Total quantity on hand, by unit" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource SummaryCard}" Click="CardLow_Click" ToolTip="Show Low Stock items">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource LowStockBgBrush}" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE74B;" Foreground="{StaticResource LowStockFgBrush}"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0">
                                <TextBlock x:Name="LowStockValue" Text="0" FontSize="26" FontWeight="Bold" Margin="0,-4,0,0"/>
                                <TextBlock Text="Low Stock Items" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LowStockCaption" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource SummaryCard}" Click="CardCritical_Click" ToolTip="Show Critical Stock items">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource CriticalStockBgBrush}" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE7BA;" Foreground="{StaticResource CriticalStockFgBrush}"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0">
                                <TextBlock x:Name="CriticalStockValue" Text="0" FontSize="26" FontWeight="Bold" Margin="0,-4,0,0"/>
                                <TextBlock Text="Critical Stock Items" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CriticalStockCaption" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource SummaryCard}" Click="CardOut_Click" ToolTip="Show Out of Stock items">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource OutOfStockBgBrush}" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" Foreground="{StaticResource OutOfStockFgBrush}"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0">
                                <TextBlock x:Name="OutOfStockValue" Text="0" FontSize="26" FontWeight="Bold" Margin="0,-4,0,0"/>
                                <TextBlock Text="Out of Stock Items" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Zero quantity available" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource SummaryCard}" Click="CardExpiring_Click" ToolTip="Show items expiring soon">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource LavenderBrush}" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE823;" Foreground="{StaticResource PrimaryDarkBrush}"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0">
                                <TextBlock x:Name="ExpiringSoonValue" Text="0" FontSize="26" FontWeight="Bold" Margin="0,-4,0,0"/>
                                <TextBlock Text="Expiring Soon" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ExpiringSoonCaption" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </UniformGrid>

                <!-- Tables -->
                <Grid x:Name="TablesGrid" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Stock Alerts: exactly 3 columns -->
                    <Border Style="{StaticResource Card}" Grid.Column="0" VerticalAlignment="Stretch">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Stock Alerts" Style="{StaticResource CardTitleText}"/>
                                    <TextBlock x:Name="AlertsCountText" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource LinkButton}" Content="View All" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ViewAllAlerts_Click"/>
                            </Grid>
                            <Grid Margin="0,14,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="126"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ITEM NAME" Style="{StaticResource TableHeaderText}"/>
                                <TextBlock Grid.Column="1" Text="AVAILABLE STOCK" Style="{StaticResource TableHeaderText}"/>
                                <TextBlock Grid.Column="2" Text="STATUS" Style="{StaticResource TableHeaderText}"/>
                            </Grid>
                            <ItemsControl x:Name="AlertsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="126"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding Name}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding QuantityText, Mode=OneWay}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource StockBadgeTemplate}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="AlertsEmpty" Style="{StaticResource MutedText}" Margin="0,10,0,4" Visibility="Collapsed"
                                       Text="No stock alerts. Every item is above its low-stock threshold."/>
                        </StackPanel>
                    </Border>

                    <!-- Recent Activities: exactly 2 columns -->
                    <Border Style="{StaticResource Card}" Grid.Column="2" VerticalAlignment="Stretch">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Recent Activities" Style="{StaticResource CardTitleText}"/>
                                    <TextBlock Text="Latest inventory operations" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource LinkButton}" Content="View All" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ViewAllActivities_Click"/>
                            </Grid>
                            <Grid Margin="0,14,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="NAME" Style="{StaticResource TableHeaderText}"/>
                                <TextBlock Grid.Column="1" Text="ACTIVITY" Style="{StaticResource TableHeaderText}"/>
                            </Grid>
                            <ItemsControl x:Name="RecentList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="0.9*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SubjectName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Top" Margin="0,0,10,0" ToolTip="{Binding SubjectName}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding ActivityType}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                               ToolTip="{Binding Description}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="RecentEmpty" Style="{StaticResource MutedText}" Margin="0,10,0,4" Visibility="Collapsed"
                                       Text="No activity yet. Actions like adding items or receiving stock will appear here."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ===================== Side panel ===================== -->
            <Grid x:Name="SidePanel" Grid.Column="1" Margin="16,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Stock health ring (like "Todays Activity") -->
                <Border x:Name="HealthCard" Style="{StaticResource Card}" Grid.ColumnSpan="3">
                    <StackPanel>
                        <TextBlock Text="Stock Health" Style="{StaticResource CardTitleText}"/>
                        <Grid Width="150" Height="150" Margin="0,18,0,0">
                            <local:RingChart x:Name="HealthRing" Width="150" Height="150" Thickness="12"
                                             RingBrush="{StaticResource PrimaryBrush}" TrackBrush="{StaticResource LavenderBrush}"/>
                            <Path Data="{StaticResource PawGeometry}" Fill="{StaticResource PrimaryBrush}" Opacity="0.85" Stretch="Uniform" Width="34" Height="34"/>
                        </Grid>
                        <TextBlock x:Name="HealthPercentText" Text="0%" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock x:Name="HealthCaption" Text="of items are in stock" Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <UniformGrid Rows="1" Margin="0,18,0,0">
                            <StackPanel>
                                <local:RingChart x:Name="LowRing" Width="40" Height="40" Thickness="6" RingBrush="{StaticResource LowStockBrush}" TrackBrush="{StaticResource LowStockBgBrush}"/>
                                <TextBlock x:Name="LowRingText" Text="0" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="Low" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <local:RingChart x:Name="CriticalRing" Width="40" Height="40" Thickness="6" RingBrush="{StaticResource CriticalStockBrush}" TrackBrush="{StaticResource CriticalStockBgBrush}"/>
                                <TextBlock x:Name="CriticalRingText" Text="0" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="Critical" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <local:RingChart x:Name="OutRing" Width="40" Height="40" Thickness="6" RingBrush="{StaticResource OutOfStockBrush}" TrackBrush="{StaticResource OutOfStockBgBrush}"/>
                                <TextBlock x:Name="OutRingText" Text="0" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="Out" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Expiring soon list -->
                <Border x:Name="ExpiryCard" Style="{StaticResource Card}" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Expiration Watch" Style="{StaticResource CardTitleText}"/>
                            <Button Style="{StaticResource LinkButton}" Content="View All" HorizontalAlignment="Right" Click="ViewAllExpiry_Click"/>
                        </Grid>
                        <ItemsControl x:Name="ExpiringList" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                <TextBlock Text="{Binding ExpirationDetail, Mode=OneWay}" Style="{StaticResource MutedText}" FontSize="11.5"/>
                                            </StackPanel>
                                            <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource ExpiryBadgeTemplate}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ExpiringEmpty" Style="{StaticResource MutedText}" Margin="0,10,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Inventory tip (like "Daily Tip") -->
                <Border x:Name="TipCard" Style="{StaticResource Card}" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0">
                    <Grid>
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Inventory Tip" Style="{StaticResource CardTitleText}"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" HorizontalAlignment="Right" ToolTip="Next tip" Click="NextTip_Click"/>
                            </Grid>
                            <TextBlock x:Name="TipText" FontFamily="Georgia" FontSize="14" LineHeight="22" TextWrapping="Wrap" Margin="0,10,40,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="&#x201D;" FontFamily="Georgia" FontSize="54" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,-6,0,-30" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Path Data="{StaticResource PawGeometry}" Fill="{StaticResource LavenderBrush}" Stretch="Uniform" Width="56" Height="56"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-6"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</local:PageBase>
