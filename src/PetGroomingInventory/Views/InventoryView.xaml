<local:PageBase x:Class="InventoryView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:PetGroomingInventory">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CountText" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="CountSubText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Click="Adjust_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8EF;"/>
                        <TextBlock Text="Stock Adjustment" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="StockIn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE896;"/>
                        <TextBlock Text="Stock In" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="AddItem_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE710;"/>
                        <TextBlock Text="Add Item" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,16,16,8" Margin="0,0,0,14">
            <WrapPanel>
                <Grid Width="250" Margin="0,0,10,8">
                    <TextBox x:Name="SearchBox" Tag="Search item name or description…" Padding="40,9,12,9" TextChanged="Filter_Changed" MaxLength="150"/>
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" HorizontalAlignment="Left" Margin="15,0,0,0"
                               Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False"/>
                </Grid>
                <ComboBox x:Name="CategoryFilter" Width="190" Margin="0,0,10,8" DisplayMemberPath="Label" SelectionChanged="Filter_Changed" ToolTip="Category"/>
                <ComboBox x:Name="PetTypeFilter" Width="150" Margin="0,0,10,8" DisplayMemberPath="Label" SelectionChanged="Filter_Changed"
                          ToolTip="Pet type (Dog and Cat also include Dog &amp; Cat items)"/>
                <ComboBox x:Name="SupplierFilter" Width="200" Margin="0,0,10,8" DisplayMemberPath="Label" SelectionChanged="Filter_Changed" ToolTip="Supplier"/>
                <ComboBox x:Name="StatusFilter" Width="175" Margin="0,0,10,8" DisplayMemberPath="Label" SelectionChanged="Filter_Changed" ToolTip="Stock status"/>
                <ComboBox x:Name="ExpiryFilter" Width="200" Margin="0,0,10,8" DisplayMemberPath="Label" SelectionChanged="Filter_Changed" ToolTip="Expiration status"/>
                <Button Style="{StaticResource GhostButton}" Margin="0,0,0,8" Click="ClearFilters_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE894;" FontSize="12"/>
                        <TextBlock Text="Clear filters" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Table -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,4,8,8">
            <Grid>
                <DataGrid x:Name="ItemsGrid" MouseDoubleClick="ItemsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Item Name" Width="2*" MinWidth="160" SortMemberPath="Name"
                                                CellTemplate="{StaticResource ItemNameTemplate}"/>
                        <DataGridTextColumn Header="Category" Width="1.3*" MinWidth="110" Binding="{Binding CategoryName}"
                                            ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Header="Pet Type" Width="1*" MinWidth="104" SortMemberPath="PetType"
                                                CellTemplate="{StaticResource PetTypeBadgeTemplate}"/>
                        <DataGridTextColumn Header="Available Qty" Width="0.9*" MinWidth="90" SortMemberPath="Quantity"
                                            Binding="{Binding QuantityText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Description" Width="1.3*" MinWidth="110" Binding="{Binding Description}"
                                            ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Retail Price" Width="0.9*" MinWidth="90" SortMemberPath="RetailPrice"
                                            Binding="{Binding PriceText, Mode=OneWay}" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Supplier" Width="1.2*" MinWidth="110" Binding="{Binding SupplierName}"
                                            ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Header="Expiration Date" Width="1.6*" MinWidth="130" SortMemberPath="ExpirationDate"
                                                CellTemplate="{StaticResource ExpiryCellTemplate}"/>
                        <DataGridTemplateColumn Header="Stock Status" Width="1.2*" MinWidth="128" SortMemberPath="Status"
                                                CellTemplate="{StaticResource StockBadgeTemplate}"/>
                        <DataGridTemplateColumn Header="Actions" Width="150" MinWidth="150" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Edit item details" Click="EditRow_Click"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE896;" ToolTip="Stock in (receive stock)" Click="StockInRow_Click"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE8EF;" ToolTip="Adjust stock" Click="AdjustRow_Click"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove item" Click="DeleteRow_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="380">
                    <Border Width="84" Height="84" CornerRadius="42" Background="{StaticResource LavenderBrush}">
                        <Path Data="{StaticResource PawGeometry}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="38" Height="38"/>
                    </Border>
                    <TextBlock x:Name="EmptyTitle" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                    <TextBlock x:Name="EmptyMessage" Style="{StaticResource MutedText}" FontSize="13" TextAlignment="Center"/>
                    <Button x:Name="EmptyActionButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                            Click="EmptyAction_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</local:PageBase>
