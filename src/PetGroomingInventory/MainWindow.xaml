<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PawStock – Pet Grooming Inventory"
        Width="1366" Height="820" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource AppBackdropBrush}"
        FontFamily="Segoe UI" Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <!-- ===================== Shell ===================== -->
        <!-- Hidden until an Admin signs in -->
        <Grid x:Name="ShellRoot" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="{StaticResource GlassBrush}" CornerRadius="24" Margin="16,16,0,16"
                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                <Grid Margin="16,22,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="6,0,0,26">
                        <Border Width="48" Height="48" CornerRadius="15" Background="{StaticResource LavenderBrush}">
                            <Path Data="{StaticResource PawGeometry}" Fill="{StaticResource PrimaryDarkBrush}" Stretch="Uniform" Width="24" Height="24"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AppNameText" Text="PawStock" FontSize="21" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                            <TextBlock Text="Pet Grooming Inventory" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" GroupName="Nav" Content="Dashboard" Tag="&#xE80F;" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavInventory" Style="{StaticResource NavButton}" GroupName="Nav" Content="Inventory" Tag="&#xE7B8;" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavStock" Style="{StaticResource NavButton}" GroupName="Nav" Content="Stock Monitoring" Tag="&#xE9D9;" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavSuppliers" Style="{StaticResource NavButton}" GroupName="Nav" Content="Suppliers" Tag="&#xE716;" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavActivities" Style="{StaticResource NavButton}" GroupName="Nav" Content="Activities" Tag="&#xE81C;" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavReports" Style="{StaticResource NavButton}" GroupName="Nav" Content="Reports" Tag="&#xE9F9;" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav" Content="Settings" Tag="&#xE713;" Checked="Nav_Checked"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Signed-in Admin card -->
                    <Border Grid.Row="2" Background="{StaticResource LavenderBrush}" CornerRadius="18" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource PrimaryBrush}">
                                    <TextBlock x:Name="AccountInitialsText" Text="A" Foreground="White" FontWeight="SemiBold" FontSize="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AccountNameText" Text="Admin" FontWeight="SemiBold" FontSize="13.5"
                                               TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                    <TextBlock Text="Admin · Aparri, Cagayan" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="ProfileButton" Style="{StaticResource SidebarCardButton}" Margin="0,12,0,0" Click="Profile_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE77B;"/>
                                    <TextBlock Text="My Profile" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarCardButton}" Margin="0,8,0,0" Click="Help_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE897;"/>
                                    <TextBlock Text="Help &amp; Support" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="LogoutButton" Style="{StaticResource SidebarCardButton}" Margin="0,8,0,0" Click="Logout_Click"
                                    ToolTip="Sign out of PawStock">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE7E8;"/>
                                    <TextBlock Text="Logout" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main area -->
            <Grid Grid.Column="1" Margin="24,16,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,6,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitleText}" Text="Dashboard"/>
                        <TextBlock x:Name="PageSubtitleText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13.5"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Grid Grid.Column="1" Width="320" Margin="16,0" VerticalAlignment="Center">
                        <TextBox x:Name="GlobalSearchBox" Tag="Search inventory items…  (press Enter)" Padding="42,11,14,11"
                                 KeyDown="GlobalSearch_KeyDown" MaxLength="150"/>
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" HorizontalAlignment="Left" Margin="17,0,0,0"
                                   Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False"/>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid>
                            <Button Style="{StaticResource CircleIconButton}" Content="&#xEA8F;" ToolTip="Stock and expiration alerts" Click="Alerts_Click"/>
                            <Border x:Name="AlertBadge" Background="{StaticResource PrimaryDarkBrush}" CornerRadius="9" MinWidth="18" Height="18"
                                    Padding="5,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                                    IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock x:Name="AlertBadgeText" Foreground="White" FontSize="10.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Button Style="{StaticResource CircleIconButton}" Margin="10,0,0,0" Content="&#xE81C;"
                                ToolTip="Activity history" Click="Activities_Click"/>
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>
            </Grid>
        </Grid>

        <!-- ===================== Login / Register / Forgot Password ===================== -->
        <ContentControl x:Name="AuthPanel" Focusable="False" Visibility="Collapsed"/>

        <!-- ===================== Modal dim overlay ===================== -->
        <Border x:Name="ModalOverlay" Background="{StaticResource OverlayBrush}" Visibility="Collapsed"/>

        <!-- ===================== Database connection error ===================== -->
        <Grid x:Name="DbErrorPanel" Background="{StaticResource AppBackdropBrush}" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="580" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36">
                <StackPanel>
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource LavenderBrush}" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE968;" FontSize="26" Foreground="{StaticResource PrimaryDarkBrush}"/>
                    </Border>
                    <TextBlock Text="Can't connect to the database" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,6"/>
                    <TextBlock x:Name="DbErrorMessage" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13.5"/>
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="14" Padding="16" Margin="0,18,0,0"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="How to fix" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="22">
                                1. Open the XAMPP Control Panel.<LineBreak/>
                                2. Click Start beside MySQL and wait until it turns green.<LineBreak/>
                                3. If MySQL is already green, check that the port shown beside MySQL in XAMPP matches the Port in the connection settings.<LineBreak/>
                                4. Click Retry below. The database and tables are created automatically.
                            </TextBlock>
                            <TextBlock x:Name="DbConfigText" Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                            <TextBox x:Name="DbErrorDetails" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                     TextWrapping="Wrap" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"
                                     Style="{x:Null}"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Retry" MinWidth="120" Click="RetryDb_Click"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Edit connection settings" Margin="10,0,0,0" Click="OpenDbConfig_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== Toast notifications ===================== -->
        <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" IsHitTestVisible="False"/>
    </Grid>
</Window>
